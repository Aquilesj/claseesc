{
  "name": "CTF XSS Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20-bookworm",
  "containerEnv": {
    "PUPPETEER_SKIP_DOWNLOAD": "true",
    "PUPPETEER_EXECUTABLE_PATH": "/usr/bin/chromium",
    "PORT": "3000",
    "BASE_URL": "http://localhost:3000"
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y chromium && npm install && npm run build",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "CTF XSS", "onAutoForward": "notify" }
  }
}

# Configuración del portal ACME (archivo señuelo del laboratorio).
# OJO: el "secreto" real de las flags NO está aquí; lo guarda un binario que
# solo se puede EJECUTAR, no leer. Encontrar este archivo es parte del recon,
# pero no te entrega la flag.
APP_NAME=ACME Intranet
APP_ENV=production
SESSION_SECRET=no-es-este-secreto-sigue-buscando
DB_HOST=127.0.0.1
DB_USER=acme_app
DB_PASS=cambia-esto-en-produccion
